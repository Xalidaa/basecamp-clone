<div class="panel" style="margin: 2rem auto;">
    <div class="page-header" style="flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 2rem;">
        <div style="flex: 1;">
            <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem; letter-spacing: -0.5px;"><%= project.name %></h1>
            <p class="text-muted" style="font-size: 0.95rem;">Created by <a href="/users/<%= project.user_id %>" style="font-weight: 500;"><%= project.author_name %></a></p>
        </div>
        
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <% if (currentUser && (currentUser.id === project.user_id || currentUser.is_admin)) { %>
                <a href="/projects/<%= project.id %>/edit" class="btn btn-secondary">Edit Project</a>
                <form action="/projects/<%= project.id %>/destroy" method="POST" onsubmit="return confirm('Are you sure you want to delete this project permanently?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            <% } %>
        </div>
    </div>
    
    <div style="margin-top: 2.5rem; font-size: 1.1rem; white-space: pre-wrap; line-height: 1.8; color: var(--text-main);">
        <%= project.description || 'No description provided.' %>
    </div>

    <!-- Attachments Section -->
    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05);">
        <h3 style="margin-bottom: 1.5rem; font-size: 1.5rem;">Attachments</h3>
        
        <% if (project.Attachments && project.Attachments.length > 0) { %>
            <ul style="list-style-type: none; padding: 0; margin-bottom: 2rem;">
            <% project.Attachments.forEach(attachment => { %>
                <li style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--bg-secondary); border-radius: 8px; margin-bottom: 0.5rem; border: 1px solid rgba(255,255,255,0.05);">
                    <div>
                        <a href="<%= attachment.file_path %>" target="_blank" style="font-weight: 500; color: var(--primary-color); text-decoration: none;">
                            <%= attachment.filename %>
                        </a>
                        <span style="font-size: 0.8rem; padding: 0.2rem 0.5rem; background: rgba(255,255,255,0.1); border-radius: 4px; margin-left: 0.5rem; text-transform: uppercase;">
                            <%= attachment.format %>
                        </span>
                    </div>
                    <% if (currentUser && (currentUser.id === attachment.user_id || currentUser.id === project.user_id || currentUser.is_admin)) { %>
                        <form action="/projects/<%= project.id %>/attachments/<%= attachment.id %>/destroy" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this attachment?');">
                            <button type="submit" class="btn btn-danger" style="padding: 0.3rem 0.8rem; font-size: 0.85rem;">Delete</button>
                        </form>
                    <% } %>
                </li>
            <% }) %>
            </ul>
        <% } else { %>
            <p class="text-muted" style="margin-bottom: 2rem;">No attachments yet.</p>
        <% } %>

        <% if (currentUser) { %>
            <div style="background: var(--bg-secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                <h4 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.1rem;">Upload Attachment</h4>
                <form action="/projects/<%= project.id %>/attachments" method="POST" enctype="multipart/form-data" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                    <input type="file" name="attachment" accept=".png,.jpg,.jpeg,.pdf,.txt" required style="flex: 1; min-width: 200px; padding: 0.5rem; background: rgba(0,0,0,0.2); border-radius: 4px; border: 1px solid rgba(255,255,255,0.1); color: var(--text-main);">
                    <button type="submit" class="btn btn-primary" style="white-space: nowrap;">Upload</button>
                </form>
                <small class="text-muted" style="display: block; margin-top: 0.5rem;">Accepted formats: PNG, JPG, PDF, TXT</small>
            </div>
        <% } %>
    </div>

    <!-- Discussions Section -->
    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 style="margin: 0; font-size: 1.5rem;">Discussions</h3>
            <% if (currentUser && (currentUser.id === project.user_id || currentUser.is_admin)) { %>
                <a href="/projects/<%= project.id %>/threads/new" class="btn btn-primary" style="font-size: 0.9rem;">+ New Thread</a>
            <% } %>
        </div>

        <% if (project.Threads && project.Threads.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% project.Threads.forEach(thread => { %>
                <div style="background: var(--bg-secondary); border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.05); transition: transform 0.2s ease;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <h4 style="margin: 0 0 0.5rem 0; font-size: 1.2rem; color: var(--primary-color);"><%= thread.title %></h4>
                        <% if (currentUser && (currentUser.id === project.user_id || currentUser.is_admin)) { %>
                            <div style="display: flex; gap: 0.5rem;">
                                <a href="/threads/<%= thread.id %>/edit" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none; padding: 0.3rem 0.6rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 4px;">Edit</a>
                                <form action="/threads/<%= thread.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this thread?');">
                                    <button type="submit" style="font-size: 0.85rem; color: var(--danger); background: transparent; border: 1px solid var(--danger); padding: 0.3rem 0.6rem; border-radius: 4px; cursor: pointer;">Delete</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                    <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 1rem;">
                        Posted by <strong><%= thread.author ? thread.author.username : 'Unknown' %></strong>
                    </p>
                    <div style="white-space: pre-wrap; line-height: 1.6; color: var(--text-main); font-size: 0.95rem;">
                        <%= thread.content %>
                    </div>
                </div>
            <% }) %>
            </div>
        <% } else { %>
            <p class="text-muted">No discussion threads started yet.</p>
        <% } %>
    </div>

    
    <div style="margin-top: 4rem; border-top: 1px solid var(--border-color); padding-top: 2rem;">
        <a href="/projects" class="btn btn-secondary">&larr; Back to Dashboard</a>
    </div>
</div>
