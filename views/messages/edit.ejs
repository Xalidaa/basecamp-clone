<div class="panel" style="margin: 2rem auto; max-width: 600px;">
    <div style="margin-bottom: 2rem;">
        <a href="/threads/<%= message.thread_id %>" class="text-muted" style="text-decoration: none; font-size: 0.9rem;">&larr; Back to Thread</a>
    </div>

    <h1 style="font-size: 1.8rem; margin-bottom: 2rem;">Edit Message</h1>

    <div style="background: var(--bg-secondary); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
        <form action="/threads/messages/<%= message.id %>" method="POST">
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Message Content</label>
                <textarea name="content" required style="width: 100%; min-height: 150px; padding: 1rem; border-radius: 8px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: var(--text-main); font-family: inherit; resize: vertical;"><%= message.content %></textarea>
            </div>
            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/threads/<%= message.thread_id %>" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
