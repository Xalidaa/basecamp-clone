<div class="container mt-4">
    <h2>Admin Dashboard</h2>
    <p>Manage users and their roles below.</p>

    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td>
                        <% if (user.is_admin) { %>
                            <span class="badge bg-primary">Admin</span>
                        <% } else { %>
                            <span class="badge bg-secondary">User</span>
                        <% } %>
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <% if (user.is_admin) { %>
                                <form action="/admin/users/<%= user.id %>/removeAdmin" method="POST">
                                    <button type="submit" class="btn btn-sm btn-warning">Remove Admin</button>
                                </form>
                            <% } else { %>
                                <form action="/admin/users/<%= user.id %>/setAdmin" method="POST">
                                    <button type="submit" class="btn btn-sm btn-success">Make Admin</button>
                                </form>
                            <% } %>
                            
                            <% if (user.id !== currentUser.id) { %>
                                <form action="/admin/users/<%= user.id %>/destroy" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete User</button>
                                </form>
                            <% } %>
                        </div>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
