<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyBasecamp1</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">
            <a href="/" style="color: inherit; text-decoration: none;">MyBasecamp1</a>
        </div>
        <div class="nav-links">
            <% if (currentUser) { %>
                <a href="/projects">Dashboard</a>
                <a href="/users/<%= currentUser.id %>">
                    Hi, <%= currentUser.username %> 
                    <% if (currentUser.is_admin) { %>
                        <span class="badge badge-admin">Admin</span>
                    <% } %>
                </a>
                <form action="/sign_out" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-secondary" style="padding: 0.4rem 0.8rem;">Logout</button>
                </form>
            <% } else { %>
                <a href="/sign_in">Sign In</a>
                <a href="/users/new" class="btn btn-primary" style="padding: 0.4rem 0.8rem; color: white;">Register</a>
            <% } %>
        </div>
    </nav>
    <main class="container">
        <%- body %>
    </main>
</body>
</html>
