<div class="panel" style="max-width: 800px; margin: 2rem auto;">
    <h2 style="margin-bottom: 1.5rem;">Edit Discussion Thread</h2>
    <form action="/threads/<%= thread.id %>" method="POST">
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" name="title" id="title" class="form-control" value="<%= thread.title %>" required>
        </div>
        <div class="form-group">
            <label for="content">Content</label>
            <textarea name="content" id="content" class="form-control" rows="10" required><%= thread.content %></textarea>
        </div>
        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Update Thread</button>
            <a href="/projects/<%= thread.project_id %>" class="btn btn-secondary" style="flex: 1; text-align: center;">Cancel</a>
        </div>
    </form>
    
    <hr style="margin: 2rem 0;">
    
    <div style="text-align: right;">
        <form action="/threads/<%= thread.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this thread?')">
            <button type="submit" class="btn btn-danger">Delete Thread</button>
        </form>
    </div>
</div>
